# Telegram API (получить на my.telegram.org)
API_ID=
API_HASH=

# номер телефона аккаунта userbot
PHONE=

# username бота-источника запросов (без @)
# для теста: ваш тестовый бот
# для прода: GorbushkinBot
SOURCE_BOT=

# ID чата с прайс-листом
# для теста: ID тестового чата
# для прода: ID реального чата
PRICE_CHAT_ID=

# username заказчика для уведомлений (без @)
# бот будет присылать сюда запросы которые не нашёл в прайсе
OWNER_USERNAME=

# список групп через запятую (ID с -100... или @username).
# пусто = режим групп выключен.
# пример: GROUP_CHATS=-1001234567890,@myshop_chat
GROUP_CHATS=

# ключ OpenAI для ИИ-нормализации запросов (опционально).
# пусто = fallback на прямой поиск без ИИ.
OPENAI_API_KEY=

# SOCKS5-прокси (опционально). Обходит блокировку Telegram DC
# И гео-блок OpenAI (403 unsupported_country) — трафик к OpenAI идёт через него.
# прокси должен быть в стране, которую OpenAI обслуживает (напр. Германия).
# пример: PROXY_URL=socks5://user:pass@host:port
PROXY_URL=

# === только для тестирования ===
# токен тестового бота (от @BotFather)
BOT_TOKEN=
# chat ID аккаунта юзербота (узнать через @userinfobot)
USERBOT_CHAT_ID=
